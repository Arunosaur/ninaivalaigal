{
  "dashboard": {
    "title": "GraphOps Performance (Python vs Rust)",
    "uid": "graphops-perf-001",
    "version": 1,
    "schemaVersion": 30,
    "tags": ["graphops", "spec-099", "performance"],
    "timezone": "browser",
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Request Latency (P50/P95/P99)",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(graphops_request_duration_seconds_bucket{runtime=\"rust\"}[5m]))",
            "legendFormat": "Rust P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(graphops_request_duration_seconds_bucket{runtime=\"rust\"}[5m]))",
            "legendFormat": "Rust P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(graphops_request_duration_seconds_bucket{runtime=\"rust\"}[5m]))",
            "legendFormat": "Rust P99",
            "refId": "C"
          },
          {
            "expr": "histogram_quantile(0.50, rate(graphops_request_duration_seconds_bucket{runtime=\"python\"}[5m]))",
            "legendFormat": "Python P50",
            "refId": "D"
          },
          {
            "expr": "histogram_quantile(0.95, rate(graphops_request_duration_seconds_bucket{runtime=\"python\"}[5m]))",
            "legendFormat": "Python P95",
            "refId": "E"
          },
          {
            "expr": "histogram_quantile(0.99, rate(graphops_request_duration_seconds_bucket{runtime=\"python\"}[5m]))",
            "legendFormat": "Python P99",
            "refId": "F"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          }
        ]
      },
      {
        "id": 2,
        "title": "Throughput (Requests/sec)",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(graphops_requests_total{runtime=\"rust\"}[1m])",
            "legendFormat": "Rust RPS",
            "refId": "A"
          },
          {
            "expr": "rate(graphops_requests_total{runtime=\"python\"}[1m])",
            "legendFormat": "Python RPS",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 3,
        "title": "Cache Hit Rate",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "rate(graphops_cache_hits_total{runtime=\"rust\"}[5m]) / rate(graphops_requests_total{runtime=\"rust\"}[5m]) * 100",
            "legendFormat": "Rust Cache Hit %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Database Connections",
        "type": "gauge",
        "gridPos": {
          "x": 6,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "graphops_db_connections_active{runtime=\"rust\"}",
            "legendFormat": "Active Connections",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 80, "color": "yellow"},
                {"value": 100, "color": "red"}
              ]
            },
            "max": 100
          }
        }
      },
      {
        "id": 5,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 4
        },
        "targets": [
          {
            "expr": "rate(graphops_errors_total{runtime=\"rust\"}[5m])",
            "legendFormat": "Rust Errors/sec",
            "refId": "A"
          },
          {
            "expr": "rate(graphops_errors_total{runtime=\"python\"}[5m])",
            "legendFormat": "Python Errors/sec",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Errors/sec"
          }
        ]
      },
      {
        "id": 6,
        "title": "Performance Comparison (Rust vs Python)",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 24,
          "h": 6
        },
        "targets": [
          {
            "expr": "avg(rate(graphops_request_duration_seconds_sum{runtime=\"rust\"}[5m]) / rate(graphops_request_duration_seconds_count{runtime=\"rust\"}[5m]))",
            "legendFormat": "Rust Avg Latency",
            "refId": "A",
            "format": "table"
          },
          {
            "expr": "avg(rate(graphops_request_duration_seconds_sum{runtime=\"python\"}[5m]) / rate(graphops_request_duration_seconds_count{runtime=\"python\"}[5m]))",
            "legendFormat": "Python Avg Latency",
            "refId": "B",
            "format": "table"
          }
        ]
      }
    ]
  }
}
