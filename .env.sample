# Ninaivalaigal Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# ENVIRONMENT & RUNTIME SELECTION
# =============================================================================
# Environment: dev, test, prod
NINA_ENV=dev

# Container Runtime: docker, colima, apple (Apple Container CLI)
NINA_RUNTIME=docker

# =============================================================================
# DYNAMIC PORT ASSIGNMENTS (Auto-calculated based on ENV + RUNTIME)
# =============================================================================
# Base ports + environment offset + runtime offset
# dev=+0, test=+100, prod=+200
# docker=+0, colima=+10, apple=+20
#
# Examples:
# postgres dev docker: 5432 (5432+0+0)
# postgres dev colima: 5442 (5432+0+10)
# postgres test docker: 5532 (5432+100+0)
# postgres prod apple: 5652 (5432+200+20)

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Auto-generated based on NINA_ENV and NINA_RUNTIME
# DATABASE_URL will be: postgresql://nina:${DB_PASSWORD}@localhost:${PORT}/nina_${NINA_ENV}
NINA_DB_PASSWORD=secure_nina_password_change_in_production

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
NINA_JWT_SECRET=dev_jwt_secret_change_in_production
NINA_JWT_EXPIRATION_HOURS=24

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Auto-generated based on NINA_ENV and NINA_RUNTIME
NINA_REDIS_PASSWORD=nina_redis_password_change_in_production

# =============================================================================
# CONTAINER NAMES (Auto-generated)
# =============================================================================
# Pattern: nina-${NINA_ENV}-${service}
# Examples:
# - nina-dev-db (dev environment database)
# - nina-prod-db (production environment database)
# - nina-test-redis (test environment redis)

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================
# Enable debug mode (dev/test only)
NINA_DEBUG=true

# Enable live reload (dev only)
NINA_LIVE_RELOAD=true

# =============================================================================
# PRODUCTION OPTIONS
# =============================================================================
# Enable production optimizations
NINA_PRODUCTION_MODE=false

# Enable SSL/TLS
NINA_SSL_ENABLED=false

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Health check endpoints
NINA_HEALTH_CHECK_ENABLED=true

# Metrics collection
NINA_METRICS_ENABLED=true

# Log level: DEBUG, INFO, WARNING, ERROR
NINA_LOG_LEVEL=INFO
