# ============================================================================
# ROOT DIRECTORY PROTECTION
# ============================================================================
# Goal: Keep root clean - only essential config files allowed
# Everything else must live in subdirectories

# Root guard: Ignore everything at root by default...
/*

# ...then explicitly allow essential files:
!/.gitignore
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/LICENSE

# Build files
!/Makefile
!/Makefile.compose
!/Makefile.dev
!/Dockerfile

# Python
!/pyproject.toml
!/requirements.txt
!/requirements-dev.txt

# Node.js
!/package.json
!/package-lock.json

# Database
!/alembic.ini

# Pre-commit configuration
!/.pre-commit-config.yaml
!/.pre-commit-config-enhanced.yaml

# Allow all directories (they have their own .gitignore)
!*/

# ============================================================================
# STANDARD IGNORES
# ============================================================================

# Ignore Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# IDE Configuration
# Allow .vscode/settings.json for team settings, but ignore personal configs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ArgoCD credentials (sensitive)
argocd/credentials.txt

# Configuration files with secrets
*.config.json
mcp-client-config.json
ninaivalaigal.config.json
mem0.config.json

# Environment variables
.env
.env.local
.env.dev
.env.*.dev
.env.colima.dev
.env.docker.dev

# Secrets (NEVER commit these)
configs/secrets-*.env
*.secret.env
.env.production
.env.staging

# Data directories (bind mounts - shared across runtimes)
data/postgres_*/
data/redis_*/
data/

# Runtime configuration (local machine specific)
.runtime-config

# Ignore server process file
.server.pid

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.coverage
.pytest_cache/
htmlcov/
coverage.json

# Node modules
node_modules/

# Additional Secret Protection
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.cer
secrets/
.secrets/
credentials/
.credentials/

# Database dumps and backups (may contain sensitive data)
# Note: Schema files (*.sql) are NOT ignored - they're infrastructure code
*.dump
*.backup
backup/
backups/
# Ignore only actual data dumps
*_dump.sql
*_backup.sql
dump_*.sql
backup_*.sql

# Temporary files that might contain secrets
.tmp/
tmp/
temp/
*.tmp
*.temp
node_modules

# Rust
target/
Cargo.lock
**/*.rs.bk
*.pdb


# Go build artifacts
go-services/*/grpc-gateway
go-services/*/nina-cli
go-services/*/test-binary

# Third-party client tools (should not be committed)
client-tools/
vscode-client/
**/vendor/  # Python vendor directories
go-services/load-tester/bin/
benchmarks/results/*.csv
*.importfix
