#
# Standardized Coverage Thresholds (US#410, SPEC-052)
# Source of truth for coverage thresholds across all CI/CD workflows
#
# These values should be used consistently across all GitHub Actions workflows

COVERAGE_THRESHOLD_UNIT=90
COVERAGE_THRESHOLD_INTEGRATION=80
COVERAGE_THRESHOLD_FUNCTIONAL=70
COVERAGE_THRESHOLD_OVERALL=85
COVERAGE_THRESHOLD_CHANGED_FILES=80
