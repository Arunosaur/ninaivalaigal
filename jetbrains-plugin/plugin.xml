<idea-plugin>
    <id>com.ninaivalaigal.jetbrains</id>
    <name>Ninaivalaigal</name>
    <version>1.0.0</version>
    <vendor email="support@medhasys.com" url="https://github.com/Arunosaur/ninaivalaigal">Medhasys LLC</vendor>

    <description><![CDATA[
    Native ninaivalaigal integration for JetBrains IDEs. Connects to ninaivalaigal's native MCP server for context-aware memory management.

    Features:
    - Context-aware memory capture and recall
    - Native MCP server integration (stdio transport)
    - Multi-project context isolation
    - Keyboard shortcuts (Ctrl+Shift+M to remember, Ctrl+Shift+R to recall)
    - Project-based context auto-detection
    ]]></description>

    <change-notes><![CDATA[
    Version 1.0.0 - Native Ninaivalaigal Integration:
    - Refactored from legacy mem0 to native ninaivalaigal
    - Integrated with ninaivalaigal MCP server (stdio transport)
    - Context management (start, list, switch)
    - Memory operations (remember, recall)
    ]]></change-notes>

    <idea-version since-build="221"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Actions -->
        <action id="ninaivalaigal.remember" class="com.ninaivalaigal.jetbrains.actions.RememberAction"
                text="Remember Selection" description="Remember selected text/code to ninaivalaigal">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift M"/>
        </action>

        <action id="ninaivalaigal.recall" class="com.ninaivalaigal.jetbrains.actions.RecallAction"
                text="Recall Memories" description="Recall memories from ninaivalaigal for current context">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift R"/>
        </action>

        <action id="ninaivalaigal.contextStart" class="com.ninaivalaigal.jetbrains.actions.ContextStartAction"
                text="Start Ninaivalaigal Context" description="Start a new ninaivalaigal context">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <!-- Settings -->
        <applicationConfigurable parentId="tools" instance="com.ninaivalaigal.jetbrains.settings.NinaivalaigalSettings"
                               id="com.ninaivalaigal.jetbrains.settings" displayName="Ninaivalaigal"/>
    </extensions>

    <actions>
        <group id="ninaivalaigal.MainGroup" text="Ninaivalaigal" description="Ninaivalaigal Actions">
            <add-to-group group-id="MainMenu" anchor="last"/>
            <action id="ninaivalaigal.contextMenu" class="com.ninaivalaigal.jetbrains.actions.ContextMenuAction"
                    text="Context Management" description="Manage ninaivalaigal contexts"/>
            <separator/>
            <reference ref="ninaivalaigal.remember"/>
            <reference ref="ninaivalaigal.recall"/>
        </group>
    </actions>
</idea-plugin>
