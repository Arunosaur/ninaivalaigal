# Ninaivalaigal Gateway Configuration
# SPEC-132: Gateway Protocol Architecture
# Example configuration for hybrid protocol support

version: "1.0"

gateway:
  # Server settings
  server:
    port: 13395
    host: 0.0.0.0
    read_timeout: 30s
    write_timeout: 30s
    idle_timeout: 120s

  # Gateway operation mode
  # Options: 'grpc-only', 'rest-only', 'hybrid'
  mode: hybrid

  # TLS/SSL configuration (optional)
  tls:
    enabled: false
    cert_file: /etc/gateway/certs/server.crt
    key_file: /etc/gateway/certs/server.key
    ca_file: /etc/gateway/certs/ca.crt

# Backend service definitions
backends:
  # Memory Service - currently REST, migrating to gRPC
  memory:
    name: "Memory Service"
    address: "192.168.68.66:13393"
    protocol: rest  # 'grpc' or 'rest'

    # Routing configuration
    routes:
      - path: "/api/v1/memory/*"
        methods: [GET, POST, PUT, DELETE]
      - path: "/api/v1/memories/*"
        methods: [GET, POST, PUT, DELETE]

    # Health check configuration
    health_check:
      enabled: true
      protocol: rest  # Can differ from main protocol
      path: /health
      interval: 10s
      timeout: 5s
      unhealthy_threshold: 3
      healthy_threshold: 2

    # Connection pool settings
    connection:
      max_idle_conns: 10
      max_open_conns: 50
      conn_max_lifetime: 300s

    # Retry policy
    retry:
      enabled: true
      attempts: 3
      backoff: exponential
      initial_delay: 100ms
      max_delay: 5s

  # GraphOps - native gRPC service
  graphops:
    name: "GraphOps Service"
    address: "192.168.68.66:13398"
    protocol: grpc

    routes:
      - path: "/api/v1/graph/*"
        methods: [GET, POST, PUT, DELETE]
      - path: "/api/v1/graphops/*"
        methods: [GET, POST, PUT, DELETE]

    # For gRPC services
    grpc:
      # Service definitions for reflection
      services:
        - "graphops.v1.GraphOpsService"

      # gRPC-specific settings
      max_recv_msg_size: 4194304  # 4MB
      max_send_msg_size: 4194304  # 4MB

      # Compression
      compression: gzip

    health_check:
      enabled: true
      protocol: grpc
      service: "grpc.health.v1.Health"
      interval: 10s
      timeout: 5s
      unhealthy_threshold: 3
      healthy_threshold: 2

    connection:
      max_idle_conns: 10
      max_open_conns: 50
      conn_max_lifetime: 300s

    retry:
      enabled: true
      attempts: 3
      backoff: exponential
      initial_delay: 100ms
      max_delay: 5s

  # Core API - Python REST service
  core_api:
    name: "Core API"
    address: "192.168.68.66:13390"
    protocol: rest

    routes:
      - path: "/api/v1/core/*"
        methods: [GET, POST, PUT, DELETE]
      - path: "/api/v1/admin/*"
        methods: [GET, POST]
        # Optional: require auth
        auth_required: true

    health_check:
      enabled: true
      protocol: rest
      path: /health
      interval: 10s
      timeout: 5s
      unhealthy_threshold: 3
      healthy_threshold: 2

    connection:
      max_idle_conns: 10
      max_open_conns: 50
      conn_max_lifetime: 300s

    retry:
      enabled: true
      attempts: 3
      backoff: exponential
      initial_delay: 100ms
      max_delay: 5s

# Middleware configuration (applied in order)
middleware:
  # Request logging
  - type: logging
    config:
      level: info
      format: json  # 'json' or 'text'
      include_request_body: false
      include_response_body: false
      redact_headers: ["authorization", "cookie"]

  # CORS handling
  - type: cors
    config:
      allowed_origins: ["*"]
      allowed_methods: [GET, POST, PUT, DELETE, OPTIONS]
      allowed_headers: ["*"]
      exposed_headers: ["X-Request-ID"]
      max_age: 3600
      credentials: true

  # Metrics collection
  - type: metrics
    config:
      enabled: true
      include_path: true
      include_method: true
      include_status: true

  # Rate limiting (optional, future)
  - type: rate_limit
    enabled: false
    config:
      requests_per_second: 100
      burst: 200
      key_func: client_ip

  # Authentication (optional, future)
  - type: auth
    enabled: false
    config:
      type: jwt
      secret_key_env: JWT_SECRET_KEY
      token_header: Authorization
      token_prefix: Bearer

# Observability configuration
observability:
  # Logging
  logging:
    level: info  # debug, info, warn, error
    format: json
    output: stdout

    # Structured logging fields
    fields:
      service: ninaivalaigal-gateway
      environment: ${ENVIRONMENT:dev}
      version: ${VERSION:1.0.0}

  # Metrics (Prometheus-compatible)
  metrics:
    enabled: true
    port: 9090
    path: /metrics

    # Custom metrics
    buckets:
      response_time: [0.001, 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0]

  # Distributed tracing (optional, future)
  tracing:
    enabled: false
    exporter: jaeger
    endpoint: "http://jaeger:14268/api/traces"
    sample_rate: 0.1

  # Health endpoint
  health:
    enabled: true
    path: /health

    # Aggregate backend health
    include_backends: true

# Protocol translation settings
translation:
  # REST to gRPC translation
  rest_to_grpc:
    enabled: true

    # Content type detection
    content_types:
      - application/json
      - application/x-www-form-urlencoded

    # Error mapping
    error_mapping:
      not_found: 404
      invalid_argument: 400
      permission_denied: 403
      unauthenticated: 401
      internal: 500
      unavailable: 503

  # gRPC to REST translation
  grpc_to_rest:
    enabled: true

    # JSON field naming
    json_naming: camelCase  # 'camelCase' or 'snake_case'

    # Include gRPC metadata in response
    include_metadata: false

# Advanced routing rules
routing:
  # Path rewriting (optional)
  rewrite_rules:
    - match: "^/api/v1/memories/(.*)$"
      replace: "/api/v1/memory/$1"

  # Header-based routing (optional, future)
  header_routing:
    enabled: false
    rules:
      - header: X-API-Version
        value: v2
        backend: memory_v2

  # Load balancing strategy per backend
  load_balancing:
    strategy: round_robin  # 'round_robin', 'least_conn', 'ip_hash'

# Circuit breaker configuration
circuit_breaker:
  enabled: true

  # Per-backend settings
  default:
    max_failures: 5
    timeout: 30s
    half_open_max_requests: 3
    success_threshold: 2

# Development/debugging settings
development:
  # Enable debug endpoints
  debug_endpoints: ${DEBUG:false}

  # Verbose error messages
  verbose_errors: ${DEBUG:false}

  # Allow insecure connections (dev only)
  insecure: ${INSECURE:false}

# Environment variable expansion
# Use ${VAR_NAME:default_value} syntax
# Example: ${GATEWAY_PORT:13395}
