# Test Environment - ninaivalaigal
# Source: Consolidated from .env.example
# Updated: 2025-10-30 - Integration test configuration

# ============================================================================
# ENVIRONMENT
# ============================================================================
NINAIVALAIGAL_ENV=test
NINAIVALAIGAL_DEBUG=true

# ============================================================================
# DATABASE CONFIGURATION (Use dev credentials for integration tests)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nina
POSTGRES_PASSWORD=dev_password_change_in_production  # pragma: allowlist secret
POSTGRES_DB=ninaivalaigal_dev
NINAIVALAIGAL_DB_USER=nina
NINAIVALAIGAL_DB_PASSWORD=dev_password_change_in_production  # pragma: allowlist secret
NINAIVALAIGAL_DB_NAME=ninaivalaigal_dev
NINAIVALAIGAL_DB_URL=postgresql://nina:dev_password_change_in_production@localhost:5432/ninaivalaigal_dev  # pragma: allowlist secret
NINAIVALAIGAL_JWT_SECRET=test_secret_key_for_testing_only_do_not_use_in_production  # pragma: allowlist secret
NINAIVALAIGAL_REDIS_URL=redis://localhost:6379/1

# ============================================================================
# PGBOUNCER CONFIGURATION (Transaction Mode for Tests)
# ============================================================================
PGBOUNCER_TX_PORT=6432
PGBOUNCER_SESS_PORT=6433
DATABASE_URL=postgresql://nina:dev_password_change_in_production@localhost:6432/ninaivalaigal_dev  # pragma: allowlist secret

# ============================================================================
# CORE API CONFIGURATION (For Integration Tests)
# ============================================================================
# IMPORTANT: Core API runs in container, use container IP not localhost
# Get container IP: container inspect ninaivalaigal-dev-core-api | grep IPAddress
CORE_API_BASE_URL=http://192.168.66.131:8000
API_PORT=8000

# API Test Configuration (centralized in tests/conftest.py)
TEST_API_BASE_URL=http://localhost:13390
TEST_API_TIMEOUT=30
TEST_CONCURRENT_LIMIT=50
