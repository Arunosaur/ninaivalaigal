# Nina Intelligence Stack - Frontend Environment Variables
# Copy this file to .env.local and configure for your environment

# ==============================================================================
# API Configuration
# ==============================================================================

# Backend API URL (Apple Container CLI dev: 13390, Docker: 13370)
NEXT_PUBLIC_API_URL=http://localhost:13390

# WebSocket URL for real-time features
NEXT_PUBLIC_WS_URL=ws://localhost:13390

# ==============================================================================
# Environment
# ==============================================================================

# Application environment (development, staging, production)
NEXT_PUBLIC_ENV=development

# ==============================================================================
# Runtime Configuration (Apple Container CLI Ports)
# ==============================================================================

# Apple Container CLI Dev Environment Ports:
# - Database (PostgreSQL): 5452
# - PgBouncer: 6452
# - Redis: 6399
# - API: 13390
# - UI External: 8101
# - UI Admin: 8201

# For other runtimes, use these ports:
# Docker Dev: API=13370, DB=5432, Redis=6379
# Colima Test: API=13480, DB=5542, Redis=6489

# ==============================================================================
# Optional: Feature Flags
# ==============================================================================

# Enable debug mode (shows additional logging in development)
# NEXT_PUBLIC_DEBUG=true

# Enable analytics
# NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ==============================================================================
# Setup Instructions
# ==============================================================================

# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Update NEXT_PUBLIC_API_URL with your backend URL
#
# 3. Verify backend is running:
#    curl http://localhost:13390/health
#
# 4. Start development server:
#    npm run dev
#
# 5. Access frontend:
#    http://localhost:3000

# ==============================================================================
# Security Notes
# ==============================================================================

# - Never commit .env.local to version control
# - Use GitHub Secrets for CI/CD environment variables
# - For production, use secure secret management (Vault, AWS Secrets Manager)
# - NEXT_PUBLIC_ prefixed variables are exposed to the browser
# - Keep sensitive data in backend, not in NEXT_PUBLIC_ variables
