# Apple Container CLI Configuration for Mac Studio
# Complete ninaivalaigal stack: PostgreSQL + PgBouncer + FastAPI

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Postgres (host -> container:5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
HOST_PORT=5433

# Credentials
POSTGRES_USER=nina
POSTGRES_PASSWORD=change_me_securely
POSTGRES_DB=nina

# Data volume path on Mac Studio (Note: volume permissions need work)
DB_VOLUME=$HOME/ninaivalaigal/volumes/db

# Container settings
CONTAINER_NAME=nv-db
IMAGE=pgvector/pgvector:pg15
WAIT_SEC=90

# =============================================================================
# PGBOUNCER CONFIGURATION
# =============================================================================
PGBOUNCER_PORT=6432
PGBOUNCER_CONTAINER_NAME=nv-pgbouncer
PGBOUNCER_IMAGE=nina-pgbouncer:arm64

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
API_PORT=13370
API_CONTAINER_NAME=nv-api
API_IMAGE=python:3.11-slim

# JWT Configuration
NINAIVALAIGAL_JWT_SECRET=dev-secret-change-in-production
NINAIVALAIGAL_JWT_EXPIRATION_HOURS=168

# Production toggles
API_RELOAD=false

# =============================================================================
# MEMORY SERVICE CONFIGURATION
# =============================================================================
MEMORY_PROVIDER=rust
MEMORY_SERVICE_URL=http://localhost:13393
ENABLE_LEGACY_MEM0=false

# =============================================================================
# UI CONFIGURATION
# =============================================================================
UI_PORT=8080
UI_CONTAINER_NAME=nv-ui
UI_IMAGE=ninaivalaigal-ui:latest

# Legacy mem0 compatibility (only if ENABLE_LEGACY_MEM0=true)
MEMORY_HTTP_BASE=http://localhost:7070

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# =============================================================================
# STACK CONFIGURATION
# =============================================================================
# Default database connection (via PgBouncer for production)
DATABASE_URL=postgresql://nina:CHANGE_ME_DB_PASSWORD@localhost:6432/nina  # pragma: allowlist secret
NINAIVALAIGAL_DATABASE_URL=postgresql://nina:CHANGE_ME_DB_PASSWORD@localhost:6432/nina  # pragma: allowlist secret

# Direct database connection (bypass PgBouncer - troubleshooting only)
DATABASE_URL_DIRECT=postgresql://nina:CHANGE_ME_DB_PASSWORD@localhost:5433/nina  # pragma: allowlist secret

# API Base URL
NINAIVALAIGAL_API_BASE=http://localhost:13370

# =============================================================================
# TESTING CONFIGURATION (SPEC-001 Compliance)
# =============================================================================
# Test Authentication Token (obtain from auth service)
# Usage: curl -X POST http://localhost:13390/auth/login -d '{"email":"test@example.com","password":"testpass"}'  # pragma: allowlist secret
TEST_AUTH_TOKEN=test-token-replace-with-real-jwt  # pragma: allowlist secret

# Test User Credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpass123

# Service URLs for Integration Tests
TEST_CORE_API_URL=http://localhost:13390
TEST_MEMORY_SERVICE_URL=http://localhost:13393
TEST_BUSINESS_SERVICE_URL=http://localhost:13391
TEST_ADMIN_VENDOR_URL=http://localhost:13392
TEST_GRAPH_SERVICE_URL=http://localhost:13394

# =============================================================================
# SECURITY NOTES
# =============================================================================
# IMPORTANT: Replace all CHANGE_ME_* values with secure passwords before deployment
# Generate secure passwords using: openssl rand -base64 32
# Never commit .env files to version control
# Test tokens should be obtained from dev environment, not committed

# US-954: Multi-Replica Support & Load Balancing
# Primary database URL
PRIMARY_DATABASE_URL=postgresql://user:pass@primary:5432/dbname

# Multiple replica database URLs (numbered)
REPLICA_DATABASE_URL_1=postgresql://user:pass@replica1:5432/dbname
REPLICA_DATABASE_URL_2=postgresql://user:pass@replica2:5432/dbname
REPLICA_DATABASE_URL_3=postgresql://user:pass@replica3:5432/dbname

# Or use comma-separated list
# REPLICA_DATABASE_URLS=postgresql://user:pass@replica1:5432/dbname,postgresql://user:pass@replica2:5432/dbname,postgresql://user:pass@replica3:5432/dbname

# Load balancing strategy (round_robin, least_lag, weighted, random)
LOAD_BALANCING_STRATEGY=round_robin
