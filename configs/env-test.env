# Test Environment Configuration

NINA_ENV=test
ENV_OFFSET=100

# Logging
LOG_LEVEL=info
ENABLE_DEBUG=false

# Test features
ENABLE_HOT_RELOAD=false
ENABLE_PROFILING=false
ENABLE_SQL_LOGGING=false

# CORS (restricted for test)
CORS_ORIGINS="http://localhost:8181,http://localhost:8091"

# Sessions
SESSION_TIMEOUT=1800

# API Config
UVICORN_RELOAD=0
