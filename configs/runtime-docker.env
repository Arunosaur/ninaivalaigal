# Docker Runtime Configuration
# For Docker Desktop or standard Docker Engine

NINA_RUNTIME=docker
RUNTIME_OFFSET=0
CONTAINER_COMMAND=docker
PLATFORM=linux/arm64  # Change to linux/amd64 for Intel
ARCHITECTURE=arm64     # Change to amd64 for Intel

# Docker specific settings
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
