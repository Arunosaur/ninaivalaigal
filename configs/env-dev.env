# Development Environment Configuration

NINA_ENV=dev
ENV_OFFSET=0

# Logging
LOG_LEVEL=debug
ENABLE_DEBUG=true

# Development features
ENABLE_HOT_RELOAD=true
ENABLE_PROFILING=true
ENABLE_SQL_LOGGING=true

# CORS (permissive for dev)
CORS_ORIGINS="http://localhost:*"

# Sessions
SESSION_TIMEOUT=3600

# API Config
UVICORN_RELOAD=1
