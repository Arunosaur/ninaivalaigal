# Production Environment Configuration

NINA_ENV=prod
ENV_OFFSET=200

# Logging
LOG_LEVEL=warning
ENABLE_DEBUG=false

# Production features
ENABLE_HOT_RELOAD=false
ENABLE_PROFILING=false
ENABLE_SQL_LOGGING=false

# CORS (very restricted for prod)
CORS_ORIGINS="https://app.ninaivalaigal.com,https://admin.ninaivalaigal.com"

# Sessions
SESSION_TIMEOUT=3600

# API Config
UVICORN_RELOAD=0

# Production safety
REQUIRE_HTTPS=true
ENABLE_RATE_LIMITING=true
