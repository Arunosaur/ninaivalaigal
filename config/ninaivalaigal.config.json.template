{
  "product": "ninaivalaigal",
  "engine": "eM",
  "company": "medhays",
  "server": {
    "host": "127.0.0.1",
    "port": 13370,
    "timeout": 10
  },
  "client": {
    "default_context_strategy": "git_branch",
    "cache_ttl": 30,
    "debug": false
  },
  "shell": {
    "enabled": true,
    "capture_patterns": {
      "include": ["*"],
      "exclude": ["ls", "cd", "pwd", "clear", "exit"]
    }
  },
  "storage": {
    "type": "database",
    "database_url": "${NINAIVALAIGAL_DATABASE_URL}",
    "postgresql_url": "${NINAIVALAIGAL_DATABASE_URL}",
    "backend": "${STORAGE_PROVIDER}",
    "bucket": "${STORAGE_BUCKET}",
    "prefix": "${STORAGE_PREFIX}",
    "s3": {
      "endpoint": "${STORAGE_S3_ENDPOINT}",
      "region": "${STORAGE_S3_REGION}",
      "access_key": "${STORAGE_S3_ACCESS_KEY}",
      "secret_key": "${STORAGE_S3_SECRET_KEY}",
      "use_ssl": "${STORAGE_S3_USE_SSL}",
      "force_path_style": "${STORAGE_S3_FORCE_PATH_STYLE}"
    },
    "backup_enabled": true,
    "max_memories_per_context": 1000
  }
}
