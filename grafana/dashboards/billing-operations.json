{
  "dashboard": {
    "title": "Billing Operations Dashboard",
    "tags": ["billing", "spec-147"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Usage Events Total",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(billing_usage_events_total[5m])) by (resource_type)",
            "legendFormat": "{{resource_type}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Quota Blocks Active",
        "type": "graph",
        "targets": [
          {
            "expr": "billing_quota_blocks_active",
            "legendFormat": "{{block_level}} - {{resource_type}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Stripe Sync Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(billing_stripe_sync_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 - {{sync_type}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Invoice Generation Success Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(billing_invoice_generation_total{status=\"issued\"}[5m]) / rate(billing_invoice_generation_total[5m])",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Celery Queue Depth",
        "type": "graph",
        "targets": [
          {
            "expr": "billing_celery_queue_depth",
            "legendFormat": "{{queue_name}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Celery Task Success Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(billing_celery_task_success_total[5m]) / (rate(billing_celery_task_success_total[5m]) + rate(billing_celery_task_errors_total[5m]))",
            "legendFormat": "{{task_name}} - {{queue_name}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 7,
        "title": "Active Billing Accounts",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(billing_accounts_total{status=\"active\"})",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "Active Grace Periods",
        "type": "stat",
        "targets": [
          {
            "expr": "billing_grace_periods_active",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24}
      },
      {
        "id": 9,
        "title": "Total Revenue",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(billing_revenue_total{currency=\"USD\"})",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 24}
      },
      {
        "id": 10,
        "title": "Worker Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "billing_worker_memory_usage_bytes",
            "legendFormat": "{{worker_name}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28}
      },
      {
        "id": 11,
        "title": "Worker CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "billing_worker_cpu_usage_percent",
            "legendFormat": "{{worker_name}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28}
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  }
}
