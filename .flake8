[flake8]
max-line-length = 120
# Pragmatic ignores - style over substance
# E203: whitespace before ':' (Black compatibility)
# W503: line break before binary operator (Black compatibility)
# E501: line too long (pragmatic - we set max-line-length=120)
# B008: function calls in argument defaults (FastAPI dependency injection pattern)
# D200,D202,D204,D205,D210: docstring formatting (one-line, blank lines, indentation)
# D400,D401,D403: docstring content style (punctuation, imperative mood)
# ENFORCED: D100,D101,D102,D103,D104,D105,D106,D107 (structural - must have docstrings)
extend-ignore = E203, W503, E501, B008, D200, D202, D204, D205, D210, D400, D401, D403
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info
per-file-ignores =
    tests/*:F401,F403,F841,B007,B017,D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    test_*.py:D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    **/test_*.py:D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    benchmarks/*:D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    scripts/*:B007,F841,D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    debug_*.py:D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    *validation*.py:D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    coverage/*:D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    graph-validation/*:B007,D100,D101,D102,D103,D104,D105,D106,D107,D200,D205,D400,D401,D403
    server/routers/memory.py:F821
